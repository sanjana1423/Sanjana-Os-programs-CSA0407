#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define BUFFER_SIZE 5
#define PRODUCERS 2
#define CONSUMERS 2
#define ITEMS_TO_PRODUCE 20

int buffer[BUFFER_SIZE];
int in = 0;   // index for next produced item
int out = 0;  // index for next consumed item

pthread_mutex_t mutex;
sem_t empty; // counts empty slots
sem_t full;  // counts filled slots

void *producer(void *arg) {
    int id = *(int*)arg;
    for (int i = 0; i < ITEMS_TO_PRODUCE; ++i) {
        int item = id * 1000 + i; // produce an identifiable item

        sem_wait(&empty);             // wait for empty slot
        pthread_mutex_lock(&mutex);   // enter critical section

        buffer[in] = item;
        printf("Producer %d produced %d at index %d\n", id, item, in);
        in = (in + 1) % BUFFER_SIZE;

        pthread_mutex_unlock(&mutex); // leave critical section
        sem_post(&full);              // signal that an item is available

        usleep(100000 + (rand() % 200000)); // simulate work (0.1-0.3s)
    }
    return NULL;
}

void *consumer(void *arg) {
    int id = *(int*)arg;
    for (int i = 0; i < (PRODUCERS * ITEMS_TO_PRODUCE) / CONSUMERS; ++i) {
        sem_wait(&full);              // wait for item
        pthread_mutex_lock(&mutex);   // enter critical section

        int item = buffer[out];
        printf("Consumer %d consumed %d from index %d\n", id, item, out);
        out = (out + 1) % BUFFER_SIZE;

        pthread_mutex_unlock(&mutex); // leave critical section
        sem_post(&empty);             // signal empty slot

        usleep(150000 + (rand() % 200000)); // simulate work (0.15-0.35s)
    }
    return NULL;
}

int main(void) {
    srand((unsigned)time(NULL));
    pthread_t prod[PRODUCERS], cons[CONSUMERS];
    int prod_id[PRODUCERS], cons_id[CONSUMERS];

    pthread_mutex_init(&mutex, NULL);
    sem_init(&empty, 0, BUFFER_SIZE);
    sem_init(&full,  0, 0);

    for (int i = 0; i < PRODUCERS; ++i) {
        prod_id[i] = i+1;
        if (pthread_create(&prod[i], NULL, producer, &prod_id[i]) != 0) {
            perror("pthread_create producer");
            exit(1);
        }
    }
    for (int i = 0; i < CONSUMERS; ++i) {
        cons_id[i] = i+1;
        if (pthread_create(&cons[i], NULL, consumer, &cons_id[i]) != 0) {
            perror("pthread_create consumer");
            exit(1);
        }
    }

    for (int i = 0; i < PRODUCERS; ++i) pthread_join(prod[i], NULL);
    for (int i = 0; i < CONSUMERS; ++i) pthread_join(cons[i], NULL);

    pthread_mutex_destroy(&mutex);
    sem_destroy(&empty);
    sem_destroy(&full);

    printf("All producers and consumers finished.\n");
    return 0;
}
