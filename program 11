#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <unistd.h>  // for sleep()


void* task(void* arg) {
    int thread_num = *(int*)arg; 
    for (int i = 1; i <= 5; i++) {
        printf("Thread %d is running iteration %d\n", thread_num, i);
        sleep(1); 
    }
    pthread_exit(NULL);
}

int main() {
    
    int thread_args[2] = {1, 2};

    printf("Main program: creating threads...\n");

   
    for (int i = 0; i < 2; i++) {
        if (pthread_create(&threads[i], NULL, task, &thread_args[i])) {
            fprintf(stderr, "Error creating thread %d\n", i + 1);
            return 1;
        }
    }

   
    for (int i = 0; i < 2; i++) {
        pthread_join(threads[i], NULL);
    }

    printf("Main program: all threads have finished execution.\n");
    return 0;
}

