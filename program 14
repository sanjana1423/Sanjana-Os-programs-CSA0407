#include <stdio.h>
#include <string.h>

struct {
    char fname[20];
} dir[10];

int main() {
    int n = 0, ch;
    char f[20];
    
    printf("=== Single Level Directory Simulation ===\n");

    while (1) {
        printf("\n1. Create File\n2. Delete File\n3. Search File\n4. Display Files\n5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &ch);

        switch (ch) {
            case 1:
                if (n >= 10) {
                    printf("Directory is full!\n");
                } else {
                    printf("Enter the name of the file to create: ");
                    scanf("%s", f);
                    int found = 0;
                    for (int i = 0; i < n; i++) {
                        if (strcmp(f, dir[i].fname) == 0) {
                            printf("File already exists!\n");
                            found = 1;
                            break;
                        }
                    }
                    if (!found) {
                        strcpy(dir[n].fname, f);
                        n++;
                        printf("File created successfully.\n");
                    }
                }
                break;

            case 2:
                printf("Enter the name of the file to delete: ");
                scanf("%s", f);
                int found = 0;
                for (int i = 0; i < n; i++) {
                    if (strcmp(f, dir[i].fname) == 0) {
                        found = 1;
                        for (int j = i; j < n - 1; j++) {
                            strcpy(dir[j].fname, dir[j + 1].fname);
                        }
                        n--;
                        printf("File deleted successfully.\n");
                        break;
                    }
                }
                if (!found)
                    printf("File not found!\n");
                break;

            case 3:
                printf("Enter the name of the file to search: ");
                scanf("%s", f);
                found = 0;
                for (int i = 0; i < n; i++) {
                    if (strcmp(f, dir[i].fname) == 0) {
                        printf("File '%s' found at position %d.\n", f, i + 1);
                        found = 1;
                        break;
                    }
                }
                if (!found)
                    printf("File not found!\n");
                break;

            case 4:
                if (n == 0)
                    printf("Directory is empty.\n");
                else {
                    printf("Files in the directory:\n");
                    for (int i = 0; i < n; i++)
                        printf("%d. %s\n", i + 1, dir[i].fname);
                }
                break;

            case 5:
                printf("Exiting program...\n");
                return 0;

            default:
                printf("Invalid choice! Try again.\n");
        }
    }
}
