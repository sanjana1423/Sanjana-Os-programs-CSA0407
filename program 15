#include <stdio.h>
#include <string.h>

struct {
    char fname[20];
} file[10];

struct {
    char dname[20];
    int fcount;
    struct {
        char fname[20];
    } files[10];
} dir[10];

int main() {
    int dcount = 0;
    int ch;
    char d[20], f[20];

    printf("=== Two-Level Directory Simulation ===\n");

    while (1) {
        printf("\n1. Create Directory\n2. Create File\n3. Delete File\n4. Search File\n5. Display\n6. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &ch);

        switch (ch) {
            case 1:
                printf("Enter directory name: ");
                scanf("%s", d);
                int found = 0;
                for (int i = 0; i < dcount; i++) {
                    if (strcmp(d, dir[i].dname) == 0) {
                        printf("Directory already exists!\n");
                        found = 1;
                        break;
                    }
                }
                if (!found) {
                    strcpy(dir[dcount].dname, d);
                    dir[dcount].fcount = 0;
                    dcount++;
                    printf("Directory created successfully.\n");
                }
                break;

            case 2:
                printf("Enter directory name: ");
                scanf("%s", d);
                found = 0;
                for (int i = 0; i < dcount; i++) {
                    if (strcmp(d, dir[i].dname) == 0) {
                        printf("Enter file name: ");
                        scanf("%s", f);
                        int ffound = 0;
                        for (int k = 0; k < dir[i].fcount; k++) {
                            if (strcmp(f, dir[i].files[k].fname) == 0) {
                                printf("File already exists in this directory!\n");
                                ffound = 1;
                                break;
                            }
                        }
                        if (!ffound) {
                            strcpy(dir[i].files[dir[i].fcount].fname, f);
                            dir[i].fcount++;
                            printf("File created successfully.\n");
                        }
                        found = 1;
                        break;
                    }
                }
                if (!found)
                    printf("Directory not found!\n");
                break;

            case 3:
                printf("Enter directory name: ");
                scanf("%s", d);
                found = 0;
                for (int i = 0; i < dcount; i++) {
                    if (strcmp(d, dir[i].dname) == 0) {
                        printf("Enter file name to delete: ");
                        scanf("%s", f);
                        int ffound = 0;
                        for (int k = 0; k < dir[i].fcount; k++) {
                            if (strcmp(f, dir[i].files[k].fname) == 0) {
                                ffound = 1;
                                for (int t = k; t < dir[i].fcount - 1; t++) {
                                    strcpy(dir[i].files[t].fname, dir[i].files[t + 1].fname);
                                }
                                dir[i].fcount--;
                                printf("File deleted successfully.\n");
                                break;
                            }
                        }
                        if (!ffound)
                            printf("File not found!\n");
                        found = 1;
                        break;
                    }
                }
                if (!found)
                    printf("Directory not found!\n");
                break;

            case 4:
                printf("Enter directory name: ");
                scanf("%s", d);
                found = 0;
                for (int i = 0; i < dcount; i++) {
                    if (strcmp(d, dir[i].dname) == 0) {
                        printf("Enter file name to search: ");
                        scanf("%s", f);
                        int ffound = 0;
                        for (int k = 0; k < dir[i].fcount; k++) {
                            if (strcmp(f, dir[i].files[k].fname) == 0) {
                                printf("File '%s' found in directory '%s'.\n", f, d);
                                ffound = 1;
                                break;
                            }
                        }
                        if (!ffound)
                            printf("File not found in directory '%s'.\n", d);
                        found = 1;
                        break;
                    }
                }
                if (!found)
                    printf("Directory not found!\n");
                break;

            case 5:
                if (dcount == 0)
                    printf("No directories found!\n");
                else {
                    printf("\nDirectory\tFiles\n");
                    printf("-----------------------------------\n");
                    for (int i = 0; i < dcount; i++) {
                        printf("%s\t\t", dir[i].dname);
                        if (dir[i].fcount == 0)
                            printf("No files\n");
                        else {
                            for (int k = 0; k < dir[i].fcount; k++)
                                printf("%s ", dir[i].files[k].fname);
                            printf("\n");
                        }
                    }
                }
                break;

            case 6:
                printf("Exiting program...\n");
                return 0;

            default:
                printf("Invalid choice! Try again.\n");
        }
    }
}
