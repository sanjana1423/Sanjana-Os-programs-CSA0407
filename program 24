#include <stdio.h>
#include <fcntl.h>      // for open(), O_RDWR, O_CREAT, etc.
#include <unistd.h>     // for read(), write(), close()
#include <string.h>     // for strlen()

int main() {
    int fd;  // file descriptor
    char write_buf[100] = "This is a demonstration of UNIX system calls for file management.\n";
    char read_buf[100];

    // 1. Create or open a file
    fd = creat("sample.txt", 0644); // 0644 = rw-r--r-- permissions
    if (fd < 0) {
        perror("Error creating file");
        return 1;
    }
    printf("File created successfully.\n");

    // 2. Write data to the file
    if (write(fd, write_buf, strlen(write_buf)) < 0) {
        perror("Error writing to file");
        close(fd);
        return 1;
    }
    printf("Data written to file successfully.\n");

    // 3. Close the file after writing
    close(fd);
    printf("File closed after writing.\n");

    // 4. Open the same file for reading
    fd = open("sample.txt", O_RDONLY);
    if (fd < 0) {
        perror("Error opening file for reading");
        return 1;
    }

    // 5. Read data from the file
    ssize_t bytes_read = read(fd, read_buf, sizeof(read_buf) - 1);
    if (bytes_read < 0) {
        perror("Error reading file");
        close(fd);
        return 1;
    }

    // Null-terminate and display content
    read_buf[bytes_read] = '\0';
    printf("\nData read from file:\n%s\n", read_buf);

    // 6. Close the file after reading
    close(fd);
    printf("File closed successfully.\n");

    return 0;
}
