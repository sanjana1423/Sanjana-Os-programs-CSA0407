#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>      // for open(), fcntl()
#include <unistd.h>     // for read(), write(), lseek(), close()
#include <sys/stat.h>   // for stat()
#include <dirent.h>     // for opendir(), readdir()
#include <string.h>     // for strlen()
#include <errno.h>

int main() {
    int fd;
    char buffer[100];
    struct stat fileStat;

    // --- 1. Create and open a file ---
    fd = open("example.txt", O_CREAT | O_RDWR, 0644);
    if (fd < 0) {
        perror("Error opening file");
        return 1;
    }
    printf("File 'example.txt' created/opened successfully.\n");

    // --- 2. Write data to file ---
    char *data = "Operating Systems - UNIX I/O System Calls demonstration.\n";
    write(fd, data, strlen(data));
    printf("Data written to file successfully.\n");

    // --- 3. Use lseek() to move file pointer to beginning ---
    lseek(fd, 0, SEEK_SET);

    // --- 4. Read data from file ---
    int bytes = read(fd, buffer, sizeof(buffer) - 1);
    buffer[bytes] = '\0';
    printf("\nData read from file:\n%s\n", buffer);

    // --- 5. Use fcntl() to get file descriptor flags ---
    int flags = fcntl(fd, F_GETFL);
    if (flags == -1) {
        perror("fcntl");
    } else {
        printf("File access mode: ");
        switch (flags & O_ACCMODE) {
            case O_RDONLY: printf("Read only\n"); break;
            case O_WRONLY: printf("Write only\n"); break;
            case O_RDWR:   printf("Read/Write\n"); break;
        }
    }

    // --- 6. Use stat() to get file information ---
    if (stat("example.txt", &fileStat) < 0) {
        perror("Error getting file status");
        close(fd);
        return 1;
    }

    printf("\nFile Information (stat):\n");
    printf("File Size: %ld bytes\n", fileStat.st_size);
    printf("Number of Links: %lu\n", fileStat.st_nlink);
    printf("File Permissions: %o\n", fileStat.st_mode & 0777);
    printf("Owner UID: %d\n", fileStat.st_uid);

    // --- 7. Use opendir() and readdir() to list files in current directory ---
    printf("\nFiles in Current Directory:\n");
    DIR *dir;
    struct dirent *entry;
    dir = opendir(".");
    if (dir == NULL) {
        perror("Unable to open directory");
        close(fd);
        return 1;
    }

    while ((entry = readdir(dir)) != NULL) {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);
    close(fd);
    printf("\nAll system calls executed successfully.\n");

    return 0;
}
