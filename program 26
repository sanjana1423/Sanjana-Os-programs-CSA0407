#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *fp;
    char data[100];

    // 1. Create (or open) a file and write data
    fp = fopen("filedemo.txt", "w"); // "w" creates a new file or overwrites existing one
    if (fp == NULL) {
        printf("Error creating file!\n");
        exit(1);
    }

    printf("Enter text to write into file: ");
    fgets(data, sizeof(data), stdin);
    fputs(data, fp);
    fclose(fp);
    printf("Data written successfully to filedemo.txt\n\n");

    // 2. Read the data from the file
    fp = fopen("filedemo.txt", "r");
    if (fp == NULL) {
        printf("Error opening file for reading!\n");
        exit(1);
    }

    printf("Reading content from filedemo.txt:\n");
    while (fgets(data, sizeof(data), fp) != NULL) {
        printf("%s", data);
    }
    fclose(fp);
    printf("\nFile read successfully.\n\n");

    // 3. Append new data to the existing file
    fp = fopen("filedemo.txt", "a");
    if (fp == NULL) {
        printf("Error opening file for appending!\n");
        exit(1);
    }

    printf("Enter text to append: ");
    fgets(data, sizeof(data), stdin);
    fputs(data, fp);
    fclose(fp);
    printf("Data appended successfully.\n\n");

    // 4. Display final content of the file
    fp = fopen("filedemo.txt", "r");
    if (fp == NULL) {
        printf("Error opening file!\n");
        exit(1);
    }

    printf("Final file content:\n");
    while (fgets(data, sizeof(data), fp) != NULL) {
        printf("%s", data);
    }
    fclose(fp);

    // 5. Delete the file (uncomment if you want to test file deletion)
    // if (remove("filedemo.txt") == 0)
    //     printf("\nFile deleted successfully.\n");
    // else
    //     printf("\nError deleting file.\n");

    return 0;
}
