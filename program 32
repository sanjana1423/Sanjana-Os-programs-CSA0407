#include <stdio.h>

int main() {
    int frames, pages, page[30], frame[10], counter[10];
    int i, j, k, min, next = 0, flag1, flag2, fault = 0;

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter page reference string:\n");
    for(i = 0; i < pages; i++)
        scanf("%d", &page[i]);

    for(i = 0; i < frames; i++) {
        frame[i] = -1;   // initialize frames
        counter[i] = 0;  // track usage time
    }

    printf("\nPage\tFrames\t\tStatus\n");
    printf("--------------------------------\n");

    for(i = 0; i < pages; i++) {
        flag1 = flag2 = 0;

        // Check if page is already present
        for(j = 0; j < frames; j++) {
            if(frame[j] == page[i]) {
                next++;
                counter[j] = next;  // update time (recently used)
                flag1 = flag2 = 1;
                break;
            }
        }

        // If page not found (page fault)
        if(flag1 == 0) {
            for(j = 0; j < frames; j++) {
                if(frame[j] == -1) { // empty frame found
                    next++;
                    fault++;
                    frame[j] = page[i];
                    counter[j] = next;
                    flag2 = 1;
                    break;
                }
            }
        }

        // If no empty frame, replace least recently used
        if(flag2 == 0) {
            min = 0;
            for(j = 1; j < frames; j++) {
                if(counter[j] < counter[min])
                    min = j;
            }
            next++;
            fault++;
            frame[min] = page[i];
            counter[min] = next;
        }

        // Print current frame contents
        printf("%d\t", page[i]);
        for(k = 0; k < frames; k++) {
            if(frame[k] != -1)
                printf("%d ", frame[k]);
            else
                printf("- ");
        }

        if(flag1 == 1)
            printf("\tNo Fault\n");
        else
            printf("\tPage Fault\n");
    }

    printf("\nTotal Page Faults = %d\n", fault);
    return 0;
}
