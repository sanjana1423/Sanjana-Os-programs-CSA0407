#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct File {
    char name[20];
    int start;
    int length;
};

int main() {
    struct File files[10];
    int memory[100] = {0}; // 0 means free, 1 means allocated
    int n, i, j, k, start, length, flag;

    printf("Enter number of files: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("\nEnter file name: ");
        scanf("%s", files[i].name);

        printf("Enter starting block (0-99): ");
        scanf("%d", &start);

        printf("Enter length (number of blocks): ");
        scanf("%d", &length);

        flag = 0;
        // Check if requested blocks are free
        for(j = start; j < (start + length); j++) {
            if(memory[j] == 1) {
                flag = 1;
                break;
            }
        }

        if(flag == 0) {
            // Allocate blocks
            for(j = start; j < (start + length); j++)
                memory[j] = 1;

            files[i].start = start;
            files[i].length = length;
            printf("File '%s' allocated successfully.\n", files[i].name);
        } else {
            printf("File '%s' cannot be allocated (space not available).\n", files[i].name);
            i--; // retry current file
        }
    }

    // Display file allocation table
    printf("\n\nFile Allocation Table:\n");
    printf("--------------------------------------\n");
    printf("File Name\tStart Block\tLength\n");
    printf("--------------------------------------\n");
    for(i = 0; i < n; i++) {
        printf("%s\t\t%d\t\t%d\n", files[i].name, files[i].start, files[i].length);
    }

    // Simulate sequential access
    char fname[20];
    printf("\nEnter file name to access: ");
    scanf("%s", fname);

    flag = 0;
    for(i = 0; i < n; i++) {
        if(strcmp(files[i].name, fname) == 0) {
            flag = 1;
            printf("\nAccessing file '%s' sequentially:\n", fname);
            for(k = files[i].start; k < (files[i].start + files[i].length); k++) {
                printf("Reading block %d...\n", k);
            }
            printf("File '%s' read successfully.\n", fname);
            break;
        }
    }

    if(flag == 0)
        printf("File not found!\n");

    return 0;
}
