#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct File {
    char name[20];
    int indexBlock;
    int blocks[20];
    int length;
};

int main() {
    struct File files[10];
    int memory[100] = {0}; // 0 means free, 1 means allocated
    int n, i, j, k, flag, block;

    printf("Enter number of files: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("\nEnter file name: ");
        scanf("%s", files[i].name);

        // Choose index block
        printf("Enter index block number (0-99): ");
        scanf("%d", &files[i].indexBlock);

        if(memory[files[i].indexBlock] == 1) {
            printf("Index block already allocated! Try again.\n");
            i--;
            continue;
        }

        memory[files[i].indexBlock] = 1; // allocate index block

        printf("Enter number of data blocks: ");
        scanf("%d", &files[i].length);

        printf("Enter block numbers for file '%s':\n", files[i].name);
        for(j = 0; j < files[i].length; j++) {
            scanf("%d", &block);

            if(block < 0 || block > 99) {
                printf("Invalid block number! Try again.\n");
                j--;
                continue;
            }

            if(memory[block] == 1) {
                printf("Block %d already allocated! Enter another.\n", block);
                j--;
            } else {
                files[i].blocks[j] = block;
                memory[block] = 1;
            }
        }

        printf("File '%s' allocated successfully.\n", files[i].name);
    }

    // Display file allocation table
    printf("\n\nFile Allocation Table (Indexed Allocation):\n");
    printf("-------------------------------------------------------------\n");
    printf("File Name\tIndex Block\tAllocated Data Blocks\n");
    printf("-------------------------------------------------------------\n");
    for(i = 0; i < n; i++) {
        printf("%s\t\t%d\t\t", files[i].name, files[i].indexBlock);
        for(j = 0; j < files[i].length; j++)
            printf("%d ", files[i].blocks[j]);
        printf("\n");
    }

    // Simulate file access
    char fname[20];
    printf("\nEnter file name to access: ");
    scanf("%s", fname);

    flag = 0;
    for(i = 0; i < n; i++) {
        if(strcmp(files[i].name, fname) == 0) {
            flag = 1;
            printf("\nAccessing file '%s':\n", fname);
            printf("Index block %d points to -> ", files[i].indexBlock);
            for(j = 0; j < files[i].length; j++)
                printf("%d ", files[i].blocks[j]);
            printf("\nReading file blocks sequentially:\n");
            for(j = 0; j < files[i].length; j++)
                printf("Reading block %d...\n", files[i].blocks[j]);
            printf("File '%s' read successfully.\n", fname);
            break;
        }
    }

    if(flag == 0)
        printf("File not found!\n");

    return 0;
}
