#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct File {
    char name[20];
    int start;
    int end;
    int blocks[20];
    int length;
};

int main() {
    struct File files[10];
    int memory[100] = {0}; // 0 = free, 1 = allocated
    int n, i, j, k, block, flag;

    printf("Enter number of files: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("\nEnter file name: ");
        scanf("%s", files[i].name);

        printf("Enter number of blocks for file '%s': ", files[i].name);
        scanf("%d", &files[i].length);

        printf("Enter block numbers (0–99) for file '%s':\n", files[i].name);
        for(j = 0; j < files[i].length; j++) {
            scanf("%d", &block);

            if(block < 0 || block > 99) {
                printf("Invalid block number! Try again.\n");
                j--;
                continue;
            }

            if(memory[block] == 1) {
                printf("Block %d already allocated! Enter another.\n", block);
                j--;
            } else {
                files[i].blocks[j] = block;
                memory[block] = 1;
            }
        }

        files[i].start = files[i].blocks[0];
        files[i].end = files[i].blocks[files[i].length - 1];

        printf("File '%s' allocated successfully.\n", files[i].name);
    }

    // Display file allocation table
    printf("\n\nFile Allocation Table (Linked Allocation):\n");
    printf("-----------------------------------------------------------\n");
    printf("File Name\tStart Block\tEnd Block\tAllocated Blocks\n");
    printf("-----------------------------------------------------------\n");
    for(i = 0; i < n; i++) {
        printf("%s\t\t%d\t\t%d\t\t", files[i].name, files[i].start, files[i].end);
        for(j = 0; j < files[i].length; j++) {
            printf("%d", files[i].blocks[j]);
            if(j != files[i].length - 1) printf(" -> ");
        }
        printf("\n");
    }

    // Simulate file access
    char fname[20];
    printf("\nEnter file name to access: ");
    scanf("%s", fname);

    flag = 0;
    for(i = 0; i < n; i++) {
        if(strcmp(files[i].name, fname) == 0) {
            flag = 1;
            printf("\nAccessing file '%s':\n", fname);
            printf("Start from block %d and follow linked blocks:\n", files[i].start);
            for(j = 0; j < files[i].length; j++) {
                printf("Reading block %d", files[i].blocks[j]);
                if(j != files[i].length - 1)
                    printf(" -> next block %d\n", files[i].blocks[j + 1]);
                else
                    printf(" -> NULL (end of file)\n");
            }
            printf("File '%s' read successfully.\n", fname);
            break;
        }
    }

    if(flag == 0)
        printf("File not found!\n");

    return 0;
}
