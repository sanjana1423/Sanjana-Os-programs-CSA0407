#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i, j, head, total = 0, size, direction, temp;
    int request[50], left[50], right[50];
    int lcount = 0, rcount = 0, seekSequence[100], index = 0;

    printf("Enter total number of disk requests: ");
    scanf("%d", &n);

    printf("Enter the request sequence:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter total disk size: ");
    scanf("%d", &size);

    printf("Enter head movement direction (1 for high, 0 for low): ");
    scanf("%d", &direction);

    // Divide requests into left and right based on head position
    for (i = 0; i < n; i++) {
        if (request[i] < head)
            left[lcount++] = request[i];
        else
            right[rcount++] = request[i];
    }

    // Sort both sides
    for (i = 0; i < lcount - 1; i++)
        for (j = 0; j < lcount - i - 1; j++)
            if (left[j] > left[j + 1]) {
                temp = left[j];
                left[j] = left[j + 1];
                left[j + 1] = temp;
            }

    for (i = 0; i < rcount - 1; i++)
        for (j = 0; j < rcount - i - 1; j++)
            if (right[j] > right[j + 1]) {
                temp = right[j];
                right[j] = right[j + 1];
                right[j + 1] = temp;
            }

    printf("\nDisk Head Movement Sequence (C-SCAN):\n");
    printf("%d", head);

    // C-SCAN towards high first
    if (direction == 1) {
        // Move from head to end
        for (i = 0; i < rcount; i++) {
            total += abs(head - right[i]);
            head = right[i];
            seekSequence[index++] = head;
        }

        // Jump to beginning of disk
        total += abs((size - 1) - head);
        total += (size - 1);  // circular jump back to 0
        head = 0;

        // Then move from start to left side
        for (i = 0; i < lcount; i++) {
            total += abs(head - left[i]);
            head = left[i];
            seekSequence[index++] = head;
        }
    }
    // C-SCAN towards low first
    else {
        // Move from head to start
        for (i = lcount - 1; i >= 0; i--) {
            total += abs(head - left[i]);
            head = left[i];
            seekSequence[index++] = head;
        }

        // Jump to end of disk
        total += abs(head - 0);
        total += (size - 1);  // circular jump back to end
        head = size - 1;

        // Then move from end to right side
        for (i = rcount - 1; i >= 0; i--) {
            total += abs(head - right[i]);
            head = right[i];
            seekSequence[index++] = head;
        }
    }

    // Print seek sequence
    for (i = 0; i < index; i++)
        printf(" -> %d", seekSequence[i]);

    printf("\n\nTotal Seek Time = %d", total);
    printf("\nAverage Seek Time = %.2f\n", (float)total / n);

    return 0;
}
