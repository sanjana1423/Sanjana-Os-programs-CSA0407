#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/types.h>
#include <unistd.h>

int main() {
    int shmid;
    char *str;
    key_t key = ftok("shmfile", 65); // generate a unique key

    
    shmid = shmget(key, 1024, 0666 | IPC_CREAT);
    if (shmid == -1) {
        perror("shmget failed");
        exit(1);
    }

    
    pid_t pid = fork();

    if (pid < 0) {
        perror("fork failed");
        exit(1);
    }

    
    if (pid > 0) {
        str = (char*) shmat(shmid, (void*)0, 0);
        if (str == (char*)(-1)) {
            perror("shmat failed");
            exit(1);
        }

        printf("Parent Process: Enter data to write to shared memory: ");
        fgets(str, 1024, stdin); // write data to shared memory
        printf("Parent Process: Data written in shared memory: %s\n", str);

        
    }

    
    else {
        sleep(1); // small delay to ensure parent writes first
        str = (char*) shmat(shmid, (void*)0, 0);
        if (str == (char*)(-1)) {
            perror("shmat failed");
            exit(1);
        }

        printf("Child Process: Data read from shared memory: %s\n", str);
        shmdt(str); // detach from memory
    }

    return 0;
}
