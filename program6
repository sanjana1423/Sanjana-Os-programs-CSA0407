#include <stdio.h>

struct Process {
    int pid;        // Process ID
    int bt;         // Burst Time
    int at;         // Arrival Time
    int priority;   // Priority
    int rt;         // Remaining Time
    int wt;         // Waiting Time
    int tat;        // Turnaround Time
};

int main() {
    int n, completed = 0, t = 0, minIndex;
    float avgWT = 0, avgTAT = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    struct Process p[n];

    for (int i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("\nEnter Arrival Time, Burst Time and Priority for Process P%d:\n", i + 1);
        printf("Arrival Time: ");
        scanf("%d", &p[i].at);
        printf("Burst Time: ");
        scanf("%d", &p[i].bt);
        printf("Priority (lower value = higher priority): ");
        scanf("%d", &p[i].priority);
        p[i].rt = p[i].bt;
    }

    int totalBurst = 0;
    for (int i = 0; i < n; i++)
        totalBurst += p[i].bt;

    
    while (completed != n) {
        minIndex = -1;

        
        for (int i = 0; i < n; i++) {
            if (p[i].at <= t && p[i].rt > 0) {
                if (minIndex == -1 || p[i].priority < p[minIndex].priority)
                    minIndex = i;
            }
        }

        if (minIndex == -1) {
            t++; // no process has arrived yet
            continue;
        }

       
        p[minIndex].rt--;
        t++;

        
        if (p[minIndex].rt == 0) {
            completed++;
            p[minIndex].tat = t - p[minIndex].at;
            p[minIndex].wt = p[minIndex].tat - p[minIndex].bt;

            avgWT += p[minIndex].wt;
            avgTAT += p[minIndex].tat;
        }
    }

    avgWT /= n;
    avgTAT /= n;

    printf("\nProcess\tAT\tBT\tPriority\tWT\tTAT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].priority, p[i].wt, p[i].tat);
    }

    printf("\nAverage Waiting Time = %.2f", avgWT);
    printf("\nAverage Turnaround Time = %.2f\n", avgTAT);

    return 0;
}
